        <mxCell id="CvnO4KBKDsWDTEode2Ix-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Bipartiter Graph mit Unternehmensnodes, Länderzinsnodes, Länderfinancialnodes und Rohstoffnodes" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="150" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Message Passing mit Attention zwischen Comp und Makro Nodes hier können mehrere Attention Heads verwendet" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="208" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Die Companynodes werden dann für das Clustering verwendet. Im Training werden sie als Basis zur Korrelationprediction verwendet." vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="265" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Ein kleines MLP, dass aus den GAT Embeddings ein Embedding zur Korrelationsberechnung macht. Somit soll die reine optimierung der Embeddings zur Korrelationsberechnung verhindert werden." vertex="1">
          <mxGeometry height="60" width="292.5" x="403.75" y="365" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Jedes der 8000 Embeddings aus dem GAT wird einzeln durch das CTA geschickt und in den Korrelationsberechnungsraum transformiert" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="430" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Mittelwert der Features abziehen, damit nur noch die Abweichung vom Mittelwert abgebildet wird" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="525" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Vektoren L2 Normieren, damit alle die Länge 1 haben" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="580" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Durch die Vorverarbeitung kommt nun wenn man das Dot Product berechnet eine Zahl zwischen -1 und 1 heraus was die Pearson Korrelation darstellt" vertex="1">
          <mxGeometry height="50" width="292.5" x="403.75" y="635" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;" value="&lt;b&gt;Loss Berechnung&lt;/b&gt;" vertex="1">
          <mxGeometry height="160" width="305" x="397.5" y="710" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Die Korrelationsmatrix aus dem Dotproduct wird nun mit Hilfe eines MSE Loss mit der tatsächlich auf Kurseverläufen berechneten Korrelationsmatrix verglichen" vertex="1">
          <mxGeometry height="60" width="292.5" x="403.75" y="730" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Das Modell sagt die Korrelationsmatrix auf Basis des Inputs von Zeit t für t+x vorher&amp;nbsp;" vertex="1">
          <mxGeometry height="60" width="292.5" x="403.75" y="800" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;" value="Kurskorrelationen&lt;div&gt;Berechnung der Pearson Korrelation als Ground Truth&lt;/div&gt;&lt;div&gt;Anwendung der Ledoit-Wolf-Shrinkage um Matrix Robust gegenüber Ausreißern und Schätzfehler zu machen.&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="305" x="47.5" y="990" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;fontStyle=1;fontSize=17;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Methodik" vertex="1">
          <mxGeometry height="810" width="320" x="730" y="80" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;" value="&lt;b&gt;Train Val Test&lt;/b&gt;" vertex="1">
          <mxGeometry height="390" width="305" x="737.5" y="110" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Es gibt monatliche Chunks. Für das Training werden initial ca. 24 Monate verwendet die dann von Monat 1 bis 24 nacheinander durchgegangen werden und immer die Vorhersage für t + 3 gemacht wird." vertex="1">
          <mxGeometry height="60" width="292.5" x="743.75" y="140" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Um das Early Stopping rauszufinden wird während dem Training immer gleich noch auf der Validierungsmenge getestet sobald sich das nicht mehr verbesser wird gestoppt" vertex="1">
          <mxGeometry height="60" width="292.5" x="743.75" y="208" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Um die Hyperparameter zu testen trainiert man wieder auf den Monaten 1-24 und schaut sich dann die Ergebnisse des Downstreamtasks für die Monate 25-30 an mittelt diese und nimmt die Parameter wo am besten sind." vertex="1">
          <mxGeometry height="75" width="292.5" x="743.75" y="276" as="geometry" />
        </mxCell>
        <mxCell id="CvnO4KBKDsWDTEode2Ix-48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" value="Im finalen Test wird dann auf der Menge bis zum Cut-of trainiert. Das Ergebnis für den Monat nach Cutoff bestimmt. Dann wird das Trainingswindow um den gerade vorhergesagten Monat erweitert und für das nächste Stück wieder evaluiert." vertex="1">
          <mxGeometry height="75" width="292.5" x="743.75" y="359" as="geometry" />
        </mxCell>
