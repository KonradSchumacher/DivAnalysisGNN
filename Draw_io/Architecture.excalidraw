      "boundElements": [],
      "updated": 1788960044530,
      "link": null,
      "locked": false,
      "text": "NaN\nBilanzen, GuV und Cashflow sind von Firma zu Firma\nunterschiedlich, deshalb existieren über 300 Features\nund keine Firma hat genau das gleiche Featureset. So\nentstehen Inputs mit sehr sehr vielen NaN- Werten",
      "fontSize": 44.87619047619058,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "NaN\nBilanzen, GuV und Cashflow sind von Firma zu Firma unterschiedlich, deshalb existieren über 300 Features und keine Firma hat genau das gleiche Featureset. So entstehen Inputs mit sehr sehr vielen NaN- Werten",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
