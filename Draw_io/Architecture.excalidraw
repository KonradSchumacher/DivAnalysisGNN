    {
      "id": "ExVChWILsItnqqDOtnu0d",
      "type": "text",
      "x": -1253.1675452216568,
      "y": 537.6966970399119,
      "width": 597.9160008770518,
      "height": 390.8428016151791,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
