    {
      "id": "U2VxI8lHuy3L88q92i5ZT",
      "type": "text",
      "x": -3761.3146973634794,
      "y": 71.1746800188871,
      "width": 737.5079956054688,
      "height": 78.3333333333334,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
