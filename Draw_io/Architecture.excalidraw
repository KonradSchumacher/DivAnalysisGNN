    {
      "id": "zsyslSn-QtTjna9azksHA",
      "type": "text",
      "x": -4802.530701398793,
      "y": -352.342936213545,
      "width": 922.2682931082585,
      "height": 450,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1o",
      "roundness": null,
      "seed": 605890738,
      "version": 752,
      "versionNonce": 1552408613,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790492042098,
      "created": 1789634458103,
      "link": null,
      "locked": false,
      "text": "Der RobustScaler bringt nun alle Werte auf die gleichen\nWertebereich. Weil Features wie TotalAssets so\nungefähr bei 20 liegen aber kleine Zahlen wie Ratios\nimmer noch bei 0.5 oderso liegen würde sich das Modell\nnur auf die großen fokussieren. Deshalb wird alles um\nden 0 Punkt skaliert. Im Vergleich zum StandardScaler\nder X - Mean / Std rechnet benutzt der RobustScaler \nX- Median / IQR. Das hat den Vorteil, dass durch die\nAusreißer der Mean nicht verzerrt ist. IQR ist der\nInterquartilsabstand von 25% bis zum 75% Quartil.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Der RobustScaler bringt nun alle Werte auf die gleichen Wertebereich. Weil Features wie TotalAssets so ungefähr bei 20 liegen aber kleine Zahlen wie Ratios immer noch bei 0.5 oderso liegen würde sich das Modell nur auf die großen fokussieren. Deshalb wird alles um den 0 Punkt skaliert. Im Vergleich zum StandardScaler der X - Mean / Std rechnet benutzt der RobustScaler \nX- Median / IQR. Das hat den Vorteil, dass durch die Ausreißer der Mean nicht verzerrt ist. IQR ist der Interquartilsabstand von 25% bis zum 75% Quartil.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "hgtG9t-CW216Q8kMF64fI",
      "type": "text",
      "x": -1722.5172291559793,
