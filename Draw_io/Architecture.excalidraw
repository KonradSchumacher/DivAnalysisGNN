    {
      "id": "QLURgABJ1pkLU5LwuZbgO",
      "type": "text",
      "x": -381.0995527039795,
      "y": -6611.4143647849705,
      "width": 1183.7567502294341,
      "height": 1019.9999999999991,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffec99",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1w",
      "roundness": null,
      "seed": 644371634,
      "version": 6107,
      "versionNonce": 519346610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789719754226,
      "link": null,
      "locked": false,
      "text": "Es gibt ein Trainset mit 70% der Firmen. Im Trainset werden von\ndiesen 70% der Firmen die Daten von 2021-31.12.2023\nverwendet um die Parameter des VAE zu trainieren. \nDann habe ich noch ein Validierungsset das aus 15% der\nUnternehmen besteht und ebenfalls auf Daten von 2021-\n31.12.2023 basiert. Dies wird für die Parametersuche\nverwendet und kann auch für ein Earlystopping genutzt werden.\nFür das Testset werden dann wieder 15% der Unternehmen\nverwendet. Hier werden dann aber nur von diesen\nUnternehmen der zeitlich letzte verfügbare Datensatz bis zum\n31.12.2023 verwendet. \nDiese Datensätze werden dann durch den Encoder geschoben\num Embeddings zu erzeugen. Anhand dieser Embeddings wird\ndann ein Portfolio erstellt welches die Distanz zwischen den\nUnternehmen im Embeddingraum maximiert. Anhand dieses\nEmbeddingsportfolios werden dann vom 01.01.2024 die Kurse\nder gewählten Unternehmen gezogen und die Diversification\nRatio berechnet. Und gegen ein Random Portfolio aus dem\nTestdatensatz verglichen\n",
      "fontSize": 40.79999999999998,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es gibt ein Trainset mit 70% der Firmen. Im Trainset werden von diesen 70% der Firmen die Daten von 2021-31.12.2023 verwendet um die Parameter des VAE zu trainieren. \nDann habe ich noch ein Validierungsset das aus 15% der Unternehmen besteht und ebenfalls auf Daten von 2021-31.12.2023 basiert. Dies wird für die Parametersuche verwendet und kann auch für ein Earlystopping genutzt werden.\nFür das Testset werden dann wieder 15% der Unternehmen verwendet. Hier werden dann aber nur von diesen Unternehmen der zeitlich letzte verfügbare Datensatz bis zum 31.12.2023 verwendet. \nDiese Datensätze werden dann durch den Encoder geschoben um Embeddings zu erzeugen. Anhand dieser Embeddings wird dann ein Portfolio erstellt welches die Distanz zwischen den Unternehmen im Embeddingraum maximiert. Anhand dieses Embeddingsportfolios werden dann vom 01.01.2024 die Kurse der gewählten Unternehmen gezogen und die Diversification Ratio berechnet. Und gegen ein Random Portfolio aus dem Testdatensatz verglichen\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1789638940458,
      "baseFontSize": null
    },
