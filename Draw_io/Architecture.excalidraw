      "roundness": null,
      "seed": 1901428378,
      "version": 2127,
      "versionNonce": 1684259954,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789638276373,
      "link": null,
      "locked": false,
      "text": "Wenn Train und Eval Menge\ngleich sind sollte ich eine\nAblationsstudio machen wo ich\nmal nur auf 80% Trainiere und\ndann auf 20% in den Raum\nProjeziere wenn die\nAbstandsstruktur ähnlich ist, dann\nkann ich das als Beweis\nverwenden, dass das Modell nicht\noverfittet.\n",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Wenn Train und Eval Menge gleich sind sollte ich eine Ablationsstudio machen wo ich mal nur auf 80% Trainiere und dann auf 20% in den Raum Projeziere wenn die Abstandsstruktur ähnlich ist, dann kann ich das als Beweis verwenden, dass das Modell nicht overfittet.\n",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": 1789577650849,
      "baseFontSize": null
    },
