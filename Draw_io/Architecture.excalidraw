      "baseFontSize": null
    },
    {
      "id": "fG--ahcQuiLk72F_AR2cZ",
      "type": "text",
      "x": -4815.790457687139,
      "y": 769.3413466855538,
      "width": 922.2682931082585,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b2N",
      "roundness": null,
      "seed": 580612587,
      "version": 1178,
      "versionNonce": 1394800549,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1790492107998,
      "created": 1790492042449,
      "link": null,
      "locked": false,
      "text": "Weil es hier nur darum geht die Features in eine höhere\nDimension zu bringen. Bei einer linearen\nTransformatione kann das geschehen, ohne das man die\nSkalierung des Inputs verändert.",
      "fontSize": 36,
      "baseFontSize": null,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Weil es hier nur darum geht die Features in eine höhere Dimension zu bringen. Bei einer linearen Transformatione kann das geschehen, ohne das man die Skalierung des Inputs verändert.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
