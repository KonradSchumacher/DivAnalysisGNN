    {
      "id": "zlWZ3V57HlJXqgmiXEkK5",
      "type": "text",
      "x": 6581.781077785481,
      "y": -7623.590874484471,
      "width": 1420.6419753086398,
      "height": 123.99999999999994,
      "angle": 0,
