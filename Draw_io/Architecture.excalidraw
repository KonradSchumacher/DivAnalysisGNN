    {
      "id": "I4hTNosdAzMyZSzeD7KMn",
      "type": "text",
      "x": 2818.0805430569067,
      "y": 1242.6984895426979,
      "width": 894.3358154296876,
      "height": 315,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#ffc9c9",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
