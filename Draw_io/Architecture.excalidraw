    {
      "id": "F8tVWPJCwehsUrU5bINBY",
      "type": "text",
      "x": 1013.5773442047366,
      "y": -6005.651490877411,
      "width": 561.399658203125,
      "height": 495,
      "angle": 0,
      "strokeColor": "#1e1e1e",
