      "versionNonce": 514814238,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789032856858,
      "link": null,
      "locked": false,
      "text": "Train-Val-Test wird auf Firmenebene gebildet. Es\nwerden 70% der Unternehmen in Train kommen 15% in\nVal und 15% in Test. Um Dopplungen zwecks Daten aus\n2026 zu vermeiden wird im Test immer nur das letzte\nDatum verwendet",
      "fontSize": 34.7415823657937,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Train-Val-Test wird auf Firmenebene gebildet. Es werden 70% der Unternehmen in Train kommen 15% in Val und 15% in Test. Um Dopplungen zwecks Daten aus 2026 zu vermeiden wird im Test immer nur das letzte Datum verwendet",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
