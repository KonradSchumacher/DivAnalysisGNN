    {
      "id": "z4_bwuxX2HWy_khex8hjs",
      "type": "text",
      "x": 739.1767693992697,
      "y": -1811.6084407113458,
      "width": 1149.5538563515693,
      "height": 270,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0B",
      "roundness": null,
      "seed": 778721045,
      "version": 1363,
      "versionNonce": 1646745717,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788960341843,
      "link": null,
      "locked": false,
      "text": "Extreme Wertebereiche\nBilanzen, GuV und Cashflow Daten haben extreme Wertebereiche von\nmehreren Milliarden im positiven bis zu mehreren Milliarden im\nnegativen. Es besteht die Gefahr, dass Extremwerte dominieren und\nkleine Werte keinen Einfluss mehr haben. Es besteht dann auch die\nGefahr das alles nach Größe gewertet wird.",
      "fontSize": 36,
      "fontFamily": 6,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Extreme Wertebereiche\nBilanzen, GuV und Cashflow Daten haben extreme Wertebereiche von mehreren Milliarden im positiven bis zu mehreren Milliarden im negativen. Es besteht die Gefahr, dass Extremwerte dominieren und kleine Werte keinen Einfluss mehr haben. Es besteht dann auch die Gefahr das alles nach Größe gewertet wird.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null,
      "created": null,
      "baseFontSize": null
    },
