        <mxCell id="N2S7xXkkrksQwrNF1eiZ-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;fontStyle=1" value="&lt;div&gt;Contextnode Config&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: normal;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Länge = Anzahl der Kontextknoten&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Spalte = ID welcher Knotentyp, welches genaue Feature, welches Land&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;font style=&quot;font-size: 9px;&quot;&gt;Dient im Grunde als Featurebeschriftung damit feestgelegt werden kann welche gewichtsmatrizen genutzt werden sollen.&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
