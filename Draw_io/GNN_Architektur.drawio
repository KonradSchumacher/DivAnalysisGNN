        <mxCell id="N2S7xXkkrksQwrNF1eiZ-9" parent="1" style="rounded=1;whiteSpace=wrap;html=1;roundedPerimeter=1;verticalAlign=top;" value="&lt;div&gt;&lt;b&gt;Type Embedding&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Es wird ein Embedding trainiert, das den Typ also Rohstoff Zins oder Makro repräsentiert und auf die Zusammenfassung der Zeitreihe addiert wird&lt;/div&gt;" vertex="1">
